<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wygl.dao.TenantDao">

    <resultMap id="resultMap" type="Tenant">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="idCard" column="id_card"/>
        <result property="userId" column="user_id"/>
        <result property="emergencyContact" column="emergency_contact"/>
        <result property="emergencyPhone" column="emergency_phone"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findById" resultMap="resultMap">
        SELECT * FROM t_tenant WHERE id = #{id}
    </select>

    <update id="updateStatus" parameterType="int">
        UPDATE t_tenant SET status = #{status} WHERE id = #{id}
    </update>

    <select id="findByPhone" resultMap="resultMap">
        SELECT * FROM t_tenant WHERE phone = #{phone}
    </select>

    <select id="findPage" resultMap="resultMap">
        SELECT * FROM t_tenant
        <where>
            <if test="queryString != null and queryString != ''">
                AND (name LIKE CONCAT('%', #{queryString}, '%')
                OR phone LIKE CONCAT('%', #{queryString}, '%'))
            </if>
            <if test="status != null">AND t_tenant.status = #{status}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="Tenant" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_tenant (name, phone, id_card, user_id, emergency_contact, emergency_phone, status, create_time)
        VALUES (#{name}, #{phone}, #{idCard}, #{userId}, #{emergencyContact}, #{emergencyPhone}, #{status}, NOW())
    </insert>

    <update id="update" parameterType="Tenant">
        UPDATE t_tenant
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="int">
        DELETE FROM t_tenant WHERE id = #{id}
    </delete>

    <select id="countByPhone" resultType="int">
        SELECT COUNT(*) FROM t_tenant WHERE phone = #{phone}
    </select>

</mapper>
