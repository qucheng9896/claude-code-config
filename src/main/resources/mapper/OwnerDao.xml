<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wygl.dao.OwnerDao">

    <resultMap id="ownerResultMap" type="Owner">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="idCard" column="id_card"/>
        <result property="userId" column="user_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findById" resultMap="ownerResultMap">
        SELECT * FROM t_owner WHERE id = #{id}
    </select>

    <select id="findByPhone" resultMap="ownerResultMap">
        SELECT * FROM t_owner WHERE phone = #{phone}
    </select>

    <select id="findPage" resultMap="ownerResultMap">
        SELECT * FROM t_owner
        <where>
            <if test="queryString != null and queryString != ''">
                AND (name LIKE CONCAT('%', #{queryString}, '%')
                OR phone LIKE CONCAT('%', #{queryString}, '%'))
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="Owner" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_owner (name, phone, id_card, user_id, status, create_time)
        VALUES (#{name}, #{phone}, #{idCard}, #{userId}, #{status}, NOW())
    </insert>

    <update id="update" parameterType="Owner">
        UPDATE t_owner
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="int">
        DELETE FROM t_owner WHERE id = #{id}
    </delete>

    <select id="countByPhone" resultType="int">
        SELECT COUNT(*) FROM t_owner WHERE phone = #{phone}
    </select>

    <select id="countHousesByOwnerId" resultType="int">
        SELECT COUNT(*) FROM t_house WHERE owner_id = #{ownerId}
    </select>

</mapper>
